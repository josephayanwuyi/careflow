# Copy to .env and fill in. Never commit real values.
APP_ENV=development            # development | testing | production
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://careflow:PASSWORD@localhost:5432/careflow_dev
TEST_DATABASE_URL=postgresql+psycopg://careflow:PASSWORD@localhost:5432/careflow_test
CORS_ORIGINS=http://localhost:5173   # comma-separated allow-list

# Optional
# ACCESS_TOKEN_MINUTES=15
# SESSION_MAX_HOURS=12
# RATELIMIT_STORAGE_URI=memory://     # use redis://... when running several workers
# LOG_LEVEL=INFO
# SEED_PASSWORD=                      # password for synthetic seed accounts (random if unset)

# Notifications & External Delivery (SMS & Email)
# SMS_PROVIDER=log                    # log | twilio | mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# EMAIL_PROVIDER=log                  # log | smtp | mock
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# MAIL_FROM=noreply@careflow.local
