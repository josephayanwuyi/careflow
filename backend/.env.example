# CareFlow Backend Configuration
# In production, set APP_ENV=production and provide strong random keys (>= 32 chars).
# Generate keys with: flask --app wsgi careflow generate-secret

APP_ENV=production                      # development | testing | production
SECRET_KEY=replace-with-64-char-random-secret
JWT_SECRET_KEY=replace-with-64-char-random-jwt-secret

# PostgreSQL connection string (psycopg3)
DATABASE_URL=postgresql+psycopg://careflow_user:strong_password@db-host:5432/careflow_prod?sslmode=require

# Web client origin (required if API and client are on different origins or for CORS validation)
CORS_ORIGINS=https://careflow.yourhospital.org

# Web refresh token cookie security (true in production requires HTTPS)
COOKIE_SECURE=true

# Rate Limiting (true in production; use redis:// when running multiple workers)
RATELIMIT_ENABLED=true
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# Token & Session Lifetimes
# ACCESS_TOKEN_MINUTES=15
# SESSION_MAX_HOURS=12

# Logging level
LOG_LEVEL=INFO

# SMS Provider (log | twilio | mock)
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Email Provider (log | smtp | mock)
EMAIL_PROVIDER=log
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# MAIL_FROM=notifications@careflow.yourhospital.org
